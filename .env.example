# Telegram
TOKEN=your_telegram_bot_token
CHANNEL_ID=-1001234567890
ADMIN_ID=123456789

# Mistral Free mode
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=45
MISTRAL_MAX_TOKENS=600
MISTRAL_TEMPERATURE=0.45

# Short in-memory sessions (no database)
SESSION_TTL_MINUTES=60
SESSION_HISTORY_MESSAGES=12
SESSION_HISTORY_CHARS=12000
MISTRAL_REQUEST_COOLDOWN_SECONDS=3

# Optional comma-separated allowlist. Empty means all users may use /talk.
MISTRAL_ALLOWED_USER_IDS=

# One-use approval link lifetime
INVITE_LINK_TTL_HOURS=24
LOG_LEVEL=INFO
